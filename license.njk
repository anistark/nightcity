---
title: License | Night City
description: The MIT License for Night City.
ogPath: license/
---
{% extends "layouts/site.njk" %}

{% block main %}
<main id="top">
  <div class="wrap">
    <article class="license" id="license">
      <h1>{{ license.title }}</h1>
      <p class="note">From the <a href="https://github.com/anistark/nightcity/blob/main/LICENSE" rel="noopener" target="_blank">LICENSE</a> file in the repo.</p>
{%- for p in license.paragraphs %}
      <p>{{ p }}</p>
{%- endfor %}
    </article>
  </div>
</main>
{% endblock %}

{% block scripts %}
<script src="{{ root }}assets/js/site.js" defer></script>
<script src="{{ root }}assets/js/pwa.js" defer></script>
{% endblock %}
