---
title: Washed away | Night City
description: This page is not here. The tide took it.
ogTitle: Night City
ogPath: ""
canonical: false
permalink: 404.html
---
{% extends "layouts/site.njk" %}

{% block headStart %}
<script>
// 404.html is served for any missing path, so pin relative links to the site root.
// On a github.io project site the root is the first path segment.
(()=>{if(location.protocol==='file:')return;const seg=location.hostname.endsWith('.github.io')?location.pathname.split('/')[1]:'';const b=document.createElement('base');b.href=seg?'/'+seg+'/':'/';document.head.append(b);})();
</script>
{% endblock %}

{% block headEnd %}
<style>
/* 404 page. The beach canvas fills the window behind the page, drawn small and scaled up with crisp pixels. */
#beach{position:fixed;inset:0;width:100%;height:100%;z-index:-1;image-rendering:pixelated;background:var(--night)}
main.lost{display:flex;align-items:center;justify-content:center}
.card{background:var(--panel);border:1px solid var(--edge);padding:36px;backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px)}
.card p{margin:20px 0 0}
.card .back{display:inline-block;margin-top:36px;border:1px solid var(--edge);padding:6px 12px;letter-spacing:.08em;text-transform:uppercase}
.card .back:hover{border-color:var(--amber);color:var(--amber)}
.card .seed{color:var(--dim)}
.foot{background:var(--panel)}
@media (max-width:640px){.card{padding:20px}}
</style>
{% endblock %}

{% block bodyStart %}
<canvas id="beach" aria-hidden="true"></canvas>
{% endblock %}

{% block main %}
<main id="top" class="lost">
  <div class="wrap">
    <div class="card">
      <p class="eyebrow">Error 404</p>
      <h1>Washed away</h1>
      <p>This page is not here. Maybe the tide took it.</p>
      <p class="seed">Beach seeded from <span id="seed"></span></p>
      <a class="back" href="{{ home }}">Back to Night City</a>
    </div>
  </div>
</main>
{% endblock %}

{% block scripts %}
<script src="assets/js/beach.js" defer></script>
<script src="assets/js/pwa.js" defer></script>
{% endblock %}
